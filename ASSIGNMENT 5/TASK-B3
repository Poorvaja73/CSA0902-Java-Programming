B3.2 – Increase the Data Size (2 Marks)
Objective: Compare the insertion time of Statement, PreparedStatement and PreparedStatement batch for 1,000, 10,000 and 100,000 records.

Use System.nanoTime() to measure execution time. Use the same generated data and database configuration for all three approaches.
Complete benchmark program
The following program implements all three insertion approaches and records their execution time. It uses a transaction for each test so that the comparison focuses on the insertion approach rather than differences in commit frequency.

import java.sql.*;
import java.util.*;

public class PassBenchmark {

    static final String URL =
        "jdbc:mysql://localhost:3306/bus_pass_db";
    static final String USER = "root";
    static final String PASSWORD = "YOUR_MYSQL_PASSWORD";

    static Connection connect() throws SQLException {
        return DriverManager.getConnection(URL, USER, PASSWORD);
    }

    static List<String[]> generatePasses(int size) {
        List<String[]> passes = new ArrayList<>();

        for (int i = 1; i <= size; i++) {
            passes.add(new String[] {
                "P" + i,
                "REG" + i,
                "Student" + i,
                String.valueOf((i % 10) + 1),
                "3500.0"
            });
        }

        return passes;
    }

    static void clearTable(Connection con) throws SQLException {
        try (Statement st = con.createStatement()) {
            st.executeUpdate("DELETE FROM bus_pass");
        }
    }

    // 1. Statement: one INSERT per record
    static void insertStatement(
            Connection con, List<String[]> passes)
            throws SQLException {

        String sql = "INSERT INTO bus_pass VALUES ('%s','%s','%s',%d,%s)";

        con.setAutoCommit(false);

        try (Statement st = con.createStatement()) {
            for (String[] p : passes) {
                String query = String.format(
                    sql,
                    p[0], p[1], p[2],
                    Integer.parseInt(p[3]), p[4]
                );

                st.executeUpdate(query);
            }

            con.commit();
        } catch (SQLException | RuntimeException e) {
            con.rollback();
            throw e;
        } finally {
            con.setAutoCommit(true);
        }
    }

    // 2. PreparedStatement: one execution per record
    static void insertPrepared(
            Connection con, List<String[]> passes)
            throws SQLException {

        String sql = "INSERT INTO bus_pass VALUES (?, ?, ?, ?, ?)";

        con.setAutoCommit(false);

        try (PreparedStatement ps = con.prepareStatement(sql)) {

            for (String[] p : passes) {
                ps.setString(1, p[0]);
                ps.setString(2, p[1]);
                ps.setString(3, p[2]);
                ps.setInt(4, Integer.parseInt(p[3]));
                ps.setDouble(5, Double.parseDouble(p[4]));

                ps.executeUpdate();
            }

            con.commit();
        } catch (SQLException | RuntimeException e) {
            con.rollback();
            throw e;
        } finally {
            con.setAutoCommit(true);
        }
    }

    // 3. PreparedStatement batch: 1,000 rows per batch
    static void insertBatch(
            Connection con, List<String[]> passes)
            throws SQLException {

        String sql = "INSERT INTO bus_pass VALUES (?, ?, ?, ?, ?)";

        con.setAutoCommit(false);

        try (PreparedStatement ps = con.prepareStatement(sql)) {

            int count = 0;

            for (String[] p : passes) {
                ps.setString(1, p[0]);
                ps.setString(2, p[1]);
                ps.setString(3, p[2]);
                ps.setInt(4, Integer.parseInt(p[3]));
                ps.setDouble(5, Double.parseDouble(p[4]));

                ps.addBatch();
                count++;

                if (count % 1000 == 0) {
                    ps.executeBatch();
                    ps.clearBatch();
                }
            }

            ps.executeBatch();
            ps.clearBatch();

            con.commit();

        } catch (SQLException | RuntimeException e) {
            con.rollback();
            throw e;
        } finally {
            con.setAutoCommit(true);
        }
    }

    static long measure(
            Connection con, List<String[]> passes, int choice)
            throws SQLException {

        clearTable(con);

        long start = System.nanoTime();

        if (choice == 1) {
            insertStatement(con, passes);
        } else if (choice == 2) {
            insertPrepared(con, passes);
        } else {
            insertBatch(con, passes);
        }

        return (System.nanoTime() - start) / 1_000_000;
    }

    public static void main(String[] args) throws Exception {

        int[] sizes = {1000, 10000, 100000};

        try (Connection con = connect()) {

            for (int size : sizes) {
                List<String[]> passes = generatePasses(size);

                System.out.println("\nRecords: " + size);

                System.out.println(
                    "Statement: " +
                    measure(con, passes, 1) + " ms"
                );

                System.out.println(
                    "PreparedStatement: " +
                    measure(con, passes, 2) + " ms"
                );

                System.out.println(
                    "PreparedStatement Batch: " +
                    measure(con, passes, 3) + " ms"
                );
            }
        }
    }
}



The Statement benchmark above uses generated values containing no SQL-special characters. For arbitrary student names or other untrusted input, use parameterized SQL rather than constructing SQL strings.
