B4.1 – Implement a Practical Migration Strategy 
Objective: Migrate existing bus-pass records from a text file into MySQL using PreparedStatement batches and a single transaction. Invalid records must be reported without stopping the migration of valid records.

The migration program will:
1. Read the existing CSV file line by line.
2. Validate the number of fields and their data types.
3. Record invalid lines in a separate error report.
4. Add valid records to a batch of 1,000.
5. Insert all valid records in one database transaction.
6. Commit if the migration succeeds; roll back if a database insertion fails.
The following implementation assumes the five-field CSV format used in B1 and B3:

pass_id,reg_no,name,route_no,amount
1. MySQL table
Run this SQL in MySQL Workbench:
USE bus_pass_db;

CREATE TABLE IF NOT EXISTS bus_pass (
    pass_id VARCHAR(20) PRIMARY KEY,
    reg_no VARCHAR(20) NOT NULL,
    name VARCHAR(100) NOT NULL,
    route_no INT NOT NULL,
    amount DOUBLE NOT NULL
) ENGINE=InnoDB;


2. Complete migration program
Create a Java file named PassMigration.java.

import java.io.*;
import java.nio.file.*;
import java.sql.*;
import java.util.*;

public class PassMigration {

    static final String URL =
        "jdbc:mysql://localhost:3306/bus_pass_db";

    static final String USER = "root";
    static final String PASSWORD = "YOUR_MYSQL_PASSWORD";

    static final int BATCH_SIZE = 1000;

    public static void migrate(String fileName)
            throws Exception {

        String sql = "INSERT INTO bus_pass "
            + "(pass_id, reg_no, name, route_no, amount) "
            + "VALUES (?, ?, ?, ?, ?)";

        int imported = 0;
        int rejected = 0;
        int lineNumber = 0;

        List<String> errors = new ArrayList<>();

        try (Connection con =
                DriverManager.getConnection(URL, USER, PASSWORD);
             BufferedReader br =
                Files.newBufferedReader(Paths.get(fileName))) {

            boolean oldAutoCommit = con.getAutoCommit();
            con.setAutoCommit(false);

            try (PreparedStatement ps = con.prepareStatement(sql)) {

                String line;
                int pending = 0;

                while ((line = br.readLine()) != null) {

                    lineNumber++;

                    // Ignore empty lines
                    if (line.trim().isEmpty()) {
                        rejected++;
                        errors.add("Line " + lineNumber
                            + ": Empty line");
                        continue;
                    }

                    String[] p = line.split(",", -1);

                    // Validate number of fields
                    if (p.length != 5) {
                        rejected++;
                        errors.add("Line " + lineNumber
                            + ": Incorrect number of fields");
                        continue;
                    }

                    try {
                        int route = Integer.parseInt(p[3].trim());
                        double amount =
                            Double.parseDouble(p[4].trim());

                        // Validate required fields and numeric values
                        if (p[0].trim().isEmpty()
                                || p[1].trim().isEmpty()
                                || p[2].trim().isEmpty()
                                || route <= 0
                                || !Double.isFinite(amount)
                                || amount < 0) {

                            throw new IllegalArgumentException(
                                "Invalid field value");
                        }

                        ps.setString(1, p[0].trim());
                        ps.setString(2, p[1].trim());
                        ps.setString(3, p[2].trim());
                        ps.setInt(4, route);
                        ps.setDouble(5, amount);

                        ps.addBatch();
                        pending++;

                        if (pending == BATCH_SIZE) {
                            ps.executeBatch();
                            ps.clearBatch();

                            imported += pending;
                            pending = 0;
                        }

                    } catch (NumberFormatException |
                             IllegalArgumentException e) {

                        rejected++;
                        errors.add("Line " + lineNumber
                            + ": " + e.getMessage()
                            + " | Record: " + line);
                    }
                }

                // Execute remaining records
                if (pending > 0) {
                    ps.executeBatch();
                    ps.clearBatch();
                    imported += pending;
                }

                // Commit all valid records together
                con.commit();

            } catch (SQLException | RuntimeException e) {

                // Undo all inserts if database insertion fails
                con.rollback();
                throw e;

            } finally {
                con.setAutoCommit(oldAutoCommit);
            }
        }

        // Write rejected records to a separate report
        Files.write(
            Paths.get("migration_errors.txt"),
            errors
        );

        System.out.println("Migration completed.");
        System.out.println("Records imported: " + imported);
        System.out.println("Records rejected: " + rejected);
        System.out.println("Error report: migration_errors.txt");
    }

    public static void main(String[] args) throws Exception {
        migrate("buspasses.csv");
    }
}



