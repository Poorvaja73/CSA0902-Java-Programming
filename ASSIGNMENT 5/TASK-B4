Implementation note: This example uses a simple comma-separated format. If student names can contain commas or quotation marks, use a proper CSV parser instead of split(). A duplicate pass ID or another database constraint failure will roll back the whole migration; production systems should report such database-level failures separately, for example by validating against a staging table before final insertion.

B4.2 – Inspect the Database Using DatabaseMetaData (1 Mark)
Objective: Retrieve information about the database product, JDBC driver and tables using Java's DatabaseMetaData interface.

Create a Java file named DatabaseInspection.java.

import java.sql.*;

public class DatabaseInspection {

    public static void main(String[] args) throws Exception {

        String url =
            "jdbc:mysql://localhost:3306/bus_pass_db";

        try (Connection con = DriverManager.getConnection(
                url, "root", "YOUR_MYSQL_PASSWORD")) {

            DatabaseMetaData dbmd = con.getMetaData();

            System.out.println("Database Information");
            System.out.println("---------------------");

            System.out.println(
                "Database Product: " +
                dbmd.getDatabaseProductName()
            );

            System.out.println(
                "Database Version: " +
                dbmd.getDatabaseProductVersion()
            );

            System.out.println(
                "JDBC Driver Name: " +
                dbmd.getDriverName()
            );

            System.out.println(
                "JDBC Driver Version: " +
                dbmd.getDriverVersion()
            );

            System.out.println("\nTables:");

            try (ResultSet tables = dbmd.getTables(
                    con.getCatalog(),
                    null,
                    "%",
                    new String[]{"TABLE"})) {

                while (tables.next()) {
                    System.out.println(
                        tables.getString("TABLE_NAME")
                    );
                }
            }
        }
    }
}



