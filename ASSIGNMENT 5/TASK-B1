B1.3 – Measure the Effect of Buffering (2 Marks)
1. Objective
The objective is to measure how buffering affects the time required to count the number of lines in files of different sizes.

Three file sizes are tested:
- 1 MB
- 10 MB
- 50 MB
Two approaches are compared:
1. Unbuffered reading using FileInputStream.
2. Buffered reading using BufferedInputStream.
2. Java Benchmark Program
The following program generates test files and measures both approaches using System.nanoTime().

import java.io.*;
import java.nio.file.*;

public class BufferBenchmark {

    static long countUnbuffered(Path file)
            throws IOException {

        long lines = 0;

        try (FileInputStream fis =
                     new FileInputStream(file.toFile())) {

            int data;

            while ((data = fis.read()) != -1) {
                if (data == '\n') {
                    lines++;
                }
            }
        }

        return lines;
    }

    static long countBuffered(Path file)
            throws IOException {

        long lines = 0;

        try (BufferedInputStream bis =
                     new BufferedInputStream(
                             new FileInputStream(file.toFile()),
                             8192)) {

            int data;

            while ((data = bis.read()) != -1) {
                if (data == '\n') {
                    lines++;
                }
            }
        }

        return lines;
    }

    static void generateFile(Path file, int sizeMB)
            throws IOException {

        byte[] block = new byte[1024 * 1024];

        // Generate newline-separated test data
        java.util.Arrays.fill(block, (byte) 'A');

        for (int i = 79; i < block.length; i += 80) {
            block[i] = '\n';
        }

        try (OutputStream out =
                     Files.newOutputStream(file)) {

            for (int i = 0; i < sizeMB; i++) {
                out.write(block);
            }
        }
    }

    public static void main(String[] args)
            throws IOException {

        int[] sizes = {1, 10, 50};

        System.out.println(
                "Size\tUnbuffered(ms)\tBuffered(ms)"
        );

        for (int size : sizes) {

            Path file = Files.createTempFile(
                    "attendance", ".log");

            generateFile(file, size);

            // Warm-up
            countUnbuffered(file);
            countBuffered(file);

            long start1 = System.nanoTime();
            long lines1 = countUnbuffered(file);
            long end1 = System.nanoTime();

            long start2 = System.nanoTime();
            long lines2 = countBuffered(file);
            long end2 = System.nanoTime();

            double unbuffered =
                    (end1 - start1) / 1_000_000.0;

            double buffered =
                    (end2 - start2) / 1_000_000.0;

            System.out.printf(
                    "%d MB\t%.2f\t\t%.2f%n",
                    size, unbuffered, buffered
            );

            System.out.println(
                    "Line counts match: " +
                    (lines1 == lines2)
            );

            Files.delete(file);
        }
    }
}



