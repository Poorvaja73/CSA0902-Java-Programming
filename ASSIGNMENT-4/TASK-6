5.5 Database operations – RegistrationDAO.java

package campus;

import java.sql.*;
import java.util.*;

public class RegistrationDAO {

    public void insertRegistration(
            String studentId,
            String studentName,
            String email,
            String department,
            int eventId) throws SQLException {

        String sql = """
            INSERT INTO registrations
            (student_id, student_name, email,
             department, event_id)
            VALUES (?, ?, ?, ?, ?)
            """;

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            ps.setString(1, studentId);
            ps.setString(2, studentName);
            ps.setString(3, email);
            ps.setString(4, department);
            ps.setInt(5, eventId);

            ps.executeUpdate();
        }
    }

    public List<Registration> getRegistrations(
            int eventId, int limit, int offset)
            throws SQLException {

        List<Registration> list = new ArrayList<>();

        String sql;

        if (eventId == 0) {
            sql = """
                SELECT r.*, e.event_name
                FROM registrations r
                JOIN events e ON r.event_id = e.event_id
                ORDER BY r.registration_id
                LIMIT ? OFFSET ?
                """;
        } else {
            sql = """
                SELECT r.*, e.event_name
                FROM registrations r
                JOIN events e ON r.event_id = e.event_id
                WHERE r.event_id = ?
                ORDER BY r.registration_id
                LIMIT ? OFFSET ?
                """;
        }

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            if (eventId == 0) {
                ps.setInt(1, limit);
                ps.setInt(2, offset);
            } else {
                ps.setInt(1, eventId);
                ps.setInt(2, limit);
                ps.setInt(3, offset);
            }

            try (ResultSet rs = ps.executeQuery()) {

                while (rs.next()) {

                    list.add(new Registration(
                        rs.getInt("registration_id"),
                        rs.getString("student_id"),
                        rs.getString("student_name"),
                        rs.getString("email"),
                        rs.getString("department"),
                        rs.getInt("event_id"),
                        rs.getString("event_name")
                    ));
                }
            }
        }

        return list;
    }

    public List<String[]> getEvents() throws SQLException {

        List<String[]> events = new ArrayList<>();

        String sql =
            "SELECT event_id, event_name FROM events ORDER BY event_id";

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                events.add(new String[]{
                    rs.getString("event_id"),
                    rs.getString("event_name")
                });
            }
        }

        return events;
    }

    public int getRegistrationCount(int eventId)
            throws SQLException {

        String sql;

        if (eventId == 0) {
            sql = "SELECT COUNT(*) FROM registrations";
        } else {
            sql = "SELECT COUNT(*) FROM registrations WHERE event_id = ?";
        }

        try (Connection con = DBConnection.getConnection();
             PreparedStatement ps = con.prepareStatement(sql)) {

            if (eventId != 0) {
                ps.setInt(1, eventId);
            }

            try (ResultSet rs = ps.executeQuery()) {
                rs.next();
                return rs.getInt(1);
            }
        }
    }
}



5.6 Business logic – RegistrationService.java

package campus;

import java.sql.SQLException;
import java.util.List;

public class RegistrationService {

    private RegistrationDAO dao = new RegistrationDAO();

    public void register(
            String studentId,
            String studentName,
            String email,
            String department,
            int eventId) throws Exception {

        if (studentId == null || studentId.isBlank()) {
            throw new IllegalArgumentException(
                "Student ID is required."
            );
        }

        if (studentName == null || studentName.isBlank()) {
            throw new IllegalArgumentException(
                "Student name is required."
            );
        }

        if (email == null ||
            !email.matches(
                "^[A-Za-z0-9+_.-]+@[A-Za-z0-9.-]+$")) {

            throw new IllegalArgumentException(
                "Enter a valid email address."
            );
        }

        if (department == null || department.isBlank()) {
            throw new IllegalArgumentException(
                "Select a department."
            );
        }

        if (eventId <= 0) {
            throw new IllegalArgumentException(
                "Select an event."
            );
        }

        dao.insertRegistration(
            studentId.trim(),
            studentName.trim(),
            email.trim(),
            department.trim(),
            eventId
        );
    }

    public List<Registration> getRegistrations(
            int eventId, int limit, int offset)
            throws SQLException {

        return dao.getRegistrations(
            eventId, limit, offset
        );
    }

    public List<String[]> getEvents() throws SQLException {
        return dao.getEvents();
    }

    public int getRegistrationCount(int eventId)
            throws SQLException {

        return dao.getRegistrationCount(eventId);
    }
}
