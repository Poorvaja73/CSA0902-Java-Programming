4.4 Pseudocode – Filter action
Algorithm: FILTER_REGISTRATIONS
BEGIN

    READ selectedEvent

    SET currentPage = 0
    SET pageSize = 100

    DISABLE Filter button

    START SwingWorker

        IN BACKGROUND:

            IF selectedEvent is All Events THEN
                FETCH registrations using LIMIT and OFFSET
            ELSE
                FETCH registrations matching selectedEvent
                using LIMIT and OFFSET
            END IF

        ON COMPLETION:

            CLEAR existing JTable rows

            FOR EACH registration in fetched data
                ADD registration to JTable
            END FOR

            UPDATE page information
            ENABLE Filter button

    END SwingWorker

END



