        }

        if (loading) return;

        registerButton.setEnabled(false);
        status.setText("Registering...");

        String id = studentId.getText();
        String name = studentName.getText();
        String mail = email.getText();
        String dept = (String) department.getSelectedItem();

        new SwingWorker<Void, Void>() {

            @Override
            protected Void doInBackground() throws Exception {

                service.register(
                    id, name, mail, dept, item.id
                );

                return null;
            }

            @Override
            protected void done() {

                registerButton.setEnabled(true);

                try {
                    get();

                    JOptionPane.showMessageDialog(
                        MainFrame.this,
                        "Registration successful!"
                    );

                    status.setText("Registration successful.");

                    clearForm();
                    currentPage = 0;
                    loadRegistrations();

                } catch (Exception ex) {

                    Throwable cause = ex.getCause();

                    if (cause instanceof java.sql.SQLIntegrityConstraintViolationException) {

                        JOptionPane.showMessageDialog(
                            MainFrame.this,
                            "You are already registered for this event.",
                            "Duplicate Registration",
                            JOptionPane.WARNING_MESSAGE
                        );

                    } else {

                        String message =
                            cause == null
                            ? ex.getMessage()
                            : cause.getMessage();

                        JOptionPane.showMessageDialog(
                            MainFrame.this,
                            message,
                            "Registration Failed",
                            JOptionPane.ERROR_MESSAGE
                        );
                    }

                    status.setText("Registration failed.");
                }
            }

        }.execute();
    }

    private void loadEvents() {

        new SwingWorker<List<String[]>, Void>() {

            @Override
            protected List<String[]> doInBackground()
                    throws Exception {

                return service.getEvents();
            }

            @Override
            protected void done() {

                try {
                    List<String[]> events = get();

                    eventCombo.removeAllItems();
                    filterCombo.removeAllItems();

                    filterCombo.addItem(
                        new EventItem(0, "All Events")
                    );

                    for (String[] event : events) {

                        EventItem item = new EventItem(
                            Integer.parseInt(event[0]),
                            event[1]
                        );

                        eventCombo.addItem(item);

                        filterCombo.addItem(
                            new EventItem(item.id, item.name)
                        );
                    }

                } catch (Exception ex) {

                    JOptionPane.showMessageDialog(
                        MainFrame.this,
                        "Unable to load events: " + ex.getMessage()
                    );
                }
            }

        }.execute();
    }

    private void loadRegistrations() {

        if (loading) return;

        loading = true;

        filterButton.setEnabled(false);
        refreshButton.setEnabled(false);
        nextButton.setEnabled(false);
        previousButton.setEnabled(false);

        status.setText("Loading registrations...");

        int offset = currentPage * PAGE_SIZE;
        int eventId = currentEventId;

        new SwingWorker<List<Registration>, Void>() {

            private int count;

            @Override
            protected List<Registration> doInBackground()
                    throws Exception {

                count = service.getRegistrationCount(eventId);

                return service.getRegistrations(
                    eventId, PAGE_SIZE, offset
                );
            }

            @Override
            protected void done() {

                try {
                    List<Registration> data = get();

                    model.setRowCount(0);

                    for (Registration r : data) {

                        model.addRow(new Object[]{
                            r.getId(),
                            r.getStudentId(),
                            r.getStudentName(),
                            r.getEmail(),
                            r.getDepartment(),
                            r.getEventName()
                        });
                    }

                    totalPages = Math.max(
                        1,
                        (int) Math.ceil(
                            count / (double) PAGE_SIZE
                        )
                    );

                    pageLabel.setText(
                        "Page " + (currentPage + 1)
                        + " of " + totalPages
                        + " | Total: " + count
                    );

                    status.setText(
                        "Registrations loaded successfully."
                    );

                } catch (Exception ex) {

                    JOptionPane.showMessageDialog(
                        MainFrame.this,
                        "Unable to load registrations: "
                            + ex.getMessage()
                    );

                    status.setText("Loading failed.");

                } finally {

                    loading = false;

                    filterButton.setEnabled(true);
                    refreshButton.setEnabled(true);

                    previousButton.setEnabled(currentPage > 0);

                    nextButton.setEnabled(
                        currentPage + 1 < totalPages
                    );
                }
            }

        }.execute();
    }

    private void exportCSV() {

        JFileChooser chooser = new JFileChooser();

        chooser.setSelectedFile(
            new java.io.File("registrations.csv")
        );

        if (chooser.showSaveDialog(this)
                != JFileChooser.APPROVE_OPTION) {
            return;
        }

        java.io.File file = chooser.getSelectedFile();

        new SwingWorker<Void, Void>() {

            @Override
            protected Void doInBackground() throws Exception {

                try (PrintWriter out =
                        new PrintWriter(
                            new FileWriter(file))) {

                    out.println(
                        "ID,Student ID,Name,Email,Department,Event"
                    );

                    int offset = 0;
                    List<Registration> batch;

                    do {

                        batch = service.getRegistrations(
                            currentEventId, 500, offset
                        );

                        for (Registration r : batch) {

                            out.println(
                                csv(r.getId()) + "," +
                                csv(r.getStudentId()) + "," +
                                csv(r.getStudentName()) + "," +
                                csv(r.getEmail()) + "," +
                                csv(r.getDepartment()) + "," +
                                csv(r.getEventName())
                            );
                        }

                        offset += batch.size();

                    } while (batch.size() == 500);
                }

                return null;
            }

            @Override
            protected void done() {

                try {
                    get();

                    JOptionPane.showMessageDialog(
                        MainFrame.this,
                        "CSV exported successfully."
                    );

                } catch (Exception ex) {

                    JOptionPane.showMessageDialog(
                        MainFrame.this,
                        "Export failed: " + ex.getMessage()
                    );
                }
            }

        }.execute();
    }

    private String csv(Object value) {

        String text = String.valueOf(value);

        return "\"" + text.replace("\"", "\"\"") + "\"";
    }

    private void clearForm() {

        studentId.setText("");
        studentName.setText("");
        email.setText("");

        if (department.getItemCount() > 0) {
            department.setSelectedIndex(0);
        }

        if (eventCombo.getItemCount() > 0) {
            eventCombo.setSelectedIndex(0);
        }
    }

    private static class EventItem {

        int id;
        String name;

        EventItem(int id, String name) {
            this.id = id;
            this.name = name;
        }

        @Override
        public String toString() {
            return name;
        }
    }
