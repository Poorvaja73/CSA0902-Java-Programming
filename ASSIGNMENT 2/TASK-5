import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

class Team {

    final String name;
    final int points;
    final int goalDiff;

    Team(String name, int points, int goalDiff) {
        this.name = name;
        this.points = points;
        this.goalDiff = goalDiff;
    }

    @Override
    public String toString() {
        return name + "(" + points + "," + goalDiff + ")";
    }
}

class Leaderboard<T> {

    private final List<T> items = new ArrayList<>();

    private final Comparator<? super T> order;

    Leaderboard(Comparator<? super T> order) {
        this.order = order;
    }

    void add(T item) {
        items.add(item);
    }

    // Accepts a list of T or its subclasses
    void addAll(List<? extends T> newItems) {
        items.addAll(newItems);
    }

    List<T> ranking() {

        // TODO 1: Create a sorted copy without modifying items
        List<T> copy = new ArrayList<>(items);

        copy.sort(order);

        return copy;
    }
}

public class LeaderboardDemo {

    public static void main(String[] args) {

        // TODO 2: Build the comparator
        Comparator<Team> byRank =
            Comparator.comparingInt((Team t) -> t.points).reversed()
            .thenComparing(
                Comparator.comparingInt(
                    (Team t) -> t.goalDiff
                ).reversed()
            )
            .thenComparing(t -> t.name);

        Leaderboard<Team> board =
            new Leaderboard<>(byRank);

        // First test
        board.add(new Team("Panthers", 9, 4));
        board.add(new Team("Eagles", 9, 6));
        board.add(new Team("Cobras", 6, 1));
        board.add(new Team("Bisons", 9, 4));

        System.out.println("First Ranking:");
        System.out.println(board.ranking());

        // Second test with multiple ties
        Leaderboard<Team> secondBoard =
            new Leaderboard<>(byRank);

        secondBoard.add(new Team("Zebras", 10, 5));
        secondBoard.add(new Team("Lions", 10, 5));
        secondBoard.add(new Team("Tigers", 10, 8));
        secondBoard.add(new Team("Wolves", 8, 3));
        secondBoard.add(new Team("Bears", 8, 3));

        System.out.println("\nSecond Ranking:");
        System.out.println(secondBoard.ranking());

        // Faulty comparator: compares only points
        Comparator<Team> faultyOrder =
            Comparator.comparingInt(
                (Team t) -> t.points
            ).reversed();

        Leaderboard<Team> faultyBoard =
            new Leaderboard<>(faultyOrder);

        faultyBoard.add(new Team("Zebras", 10, 5));
        faultyBoard.add(new Team("Lions", 10, 5));
        faultyBoard.add(new Team("Tigers", 10, 8));
        faultyBoard.add(new Team("Wolves", 8, 3));
        faultyBoard.add(new Team("Bears", 8, 3));

        System.out.println("\nFaulty Ranking:");
        System.out.println(faultyBoard.ranking());

        // Verify original list is not modified
        System.out.println("\nOriginal order is preserved:");
        System.out.println(board.ranking());
    }
}



