import java.util.HashSet;
import java.util.Set;

class Student {

    private final String regNo;
    private final String name;

    Student(String regNo, String name) {
        this.regNo = regNo;
        this.name = name;
    }

    @Override
    public boolean equals(Object o) {

        if (this == o)
            return true;

        if (!(o instanceof Student))
            return false;

        return regNo.equals(((Student) o).regNo);
    }

    // TODO 1: Override hashCode()
    @Override
    public int hashCode() {
        return regNo.hashCode();
    }

    @Override
    public String toString() {
        return regNo + " " + name;
    }
}

public class Attendance {

    public static void main(String[] args) {

        Set<Student> present = new HashSet<>();

        present.add(new Student("192311001", "Arun"));
        present.add(new Student("192311002", "Divya"));
        present.add(new Student("192311001", "Arun"));

        System.out.println("Unique students: " + present.size());

        // Test 3: Same registration number, different name
        Set<Student> test3 = new HashSet<>();

        test3.add(new Student("192311003", "Kumar"));
        test3.add(new Student("192311003", "Rahul"));

        System.out.println("Test 3 Unique students: "
            + test3.size());
    }
}
