Q1 – Handling Failure in a Bank ATM Simulation (6 Marks)
1. Shared Group Work – ATM Java Program
Java code
import java.util.Scanner;
import java.io.FileNotFoundException;
import java.io.FileReader;
import java.io.IOException;

class ATM {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int balance = 10000;

        try {
            System.out.print("Enter account number: ");
            int account = sc.nextInt();

            System.out.print("Enter withdrawal amount: ");
            int amount = sc.nextInt();

            if (amount < 0) {
                throw new IllegalArgumentException("Negative amount");
            }

            if (amount > balance) {
                throw new ArithmeticException("Insufficient balance");
            }

            FileReader fr = new FileReader("card.txt");
            fr.close();

            balance = balance - amount;

            System.out.println("Withdrawal successful");
            System.out.println("Remaining balance: " + balance);
        }

        catch (java.util.InputMismatchException e) {
            System.out.println("Invalid input. Enter numbers only.");
        }

        catch (FileNotFoundException e) {
            System.out.println("Card reader file not found.");
        }

        catch (IOException e) {
            System.out.println("File handling error.");
        }

        catch (IllegalArgumentException | ArithmeticException e) {
            System.out.println("Withdrawal failed: " + e.getMessage());
        }

        finally {
            System.out.println("ATM transaction completed.");
            sc.close();
        }
    }
}
Note: Create an empty file named card.txt in the program's working directory to test a successful withdrawal. The account number is read but is not validated against a real account database in this simulation.
